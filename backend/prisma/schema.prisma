// Prisma Schema for MediGraph AI
// 16 Normalized Entities with Provenance, Deterministic Validation, and Multi-tenant Isolation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PATIENT
  CLINICIAN
  ADMIN
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum VerificationStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EDITED
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(PATIENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile           UserProfile?
  documents         Document[]
  extractedRecords  ExtractedRecord[]
  labResults        LabResult[]
  medicalEvents     MedicalEvent[]
  documentChunks    DocumentChunk[]
  chatSessions      ChatSession[]
  generatedSummaries GeneratedSummary[]
  auditLogs         AuditLog[]
  consents          ConsentRecord[]

  @@index([email])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String?
  dateOfBirth     DateTime?
  gender          String?
  isSyntheticDemo Boolean  @default(false)
  preferences     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id               String         @id @default(uuid())
  userId           String
  originalFilename String
  storageKey       String
  mimeType         String
  fileSize         Int
  sha256Checksum   String
  processingStatus DocumentStatus @default(UPLOADED)
  pageCount        Int            @default(0)
  failureReason    String?
  uploadedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages            DocumentPage[]
  processingJobs   ProcessingJob[]
  extractedRecords ExtractedRecord[]
  chunks           DocumentChunk[]
  medicalEvents    MedicalEvent[]

  @@unique([userId, sha256Checksum])
  @@index([userId, processingStatus])
  @@index([userId, uploadedAt])
}

model DocumentPage {
  id            String   @id @default(uuid())
  documentId    String
  pageNumber    Int
  rawText       String   @db.Text
  ocrConfidence Float    @default(1.0)
  hasImages     Boolean  @default(false)
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model ProcessingJob {
  id          String    @id @default(uuid())
  documentId  String
  queueJobId  String?
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  metadata    Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, status])
  @@index([status])
}

model ExtractedRecord {
  id                   String             @id @default(uuid())
  documentId           String
  userId               String
  pageNumber           Int
  recordType           String             // e.g. "LAB_TEST", "DIAGNOSIS", "MEDICATION"
  rawText              String             @db.Text
  extractionConfidence Float              @default(1.0)
  verificationStatus   VerificationStatus @default(PENDING_REVIEW)
  reviewerNotes        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  labResults LabResult[]

  @@index([documentId, verificationStatus])
  @@index([userId, verificationStatus])
}

model LabTest {
  id           String   @id @default(uuid())
  standardCode String?  @unique // LOINC or internal canonical code
  canonicalName String   @unique // e.g. "Hemoglobin", "HbA1c", "Serum Creatinine"
  category     String   // e.g. "Hematology", "Metabolic", "Lipid Panel"
  defaultUnit  String?
  aliases      Json?    // alternative names encountered in OCR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  labResults LabResult[]

  @@index([canonicalName])
}

model LabResult {
  id                 String             @id @default(uuid())
  extractedRecordId  String
  labTestId          String?
  userId             String
  testNameRaw        String
  rawValue           String
  normalizedValue    Float?
  rawUnit            String?
  normalizedUnit     String?
  referenceRangeRaw  String?
  refLow             Float?
  refHigh            Float?
  isAbnormalFlag     Boolean            @default(false)
  testDate           DateTime
  verificationStatus VerificationStatus @default(PENDING_REVIEW)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  extractedRecord ExtractedRecord @relation(fields: [extractedRecordId], references: [id], onDelete: Cascade)
  labTest         LabTest?        @relation(fields: [labTestId], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testDate])
  @@index([labTestId, testDate])
  @@index([userId, verificationStatus])
}

model MedicalEvent {
  id          String   @id @default(uuid())
  userId      String
  documentId  String?
  eventType   String   // e.g. "LAB_PANEL", "PRESCRIPTION", "IMAGING", "CLINICAL_VISIT"
  title       String
  eventDate   DateTime
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, eventDate])
  @@index([userId, eventType])
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  userId      String
  pageNumber  Int
  chunkIndex  Int
  content     String   @db.Text
  tokenCount  Int
  metadata    Json?
  createdAt   DateTime @default(now())

  document           Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddingReference EmbeddingReference?

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
  @@index([documentId, pageNumber])
}

model EmbeddingReference {
  id         String   @id @default(uuid())
  chunkId    String   @unique
  modelName  String
  dimension  Int
  embedding  String   @db.Text // Serialized vector or pgvector representation
  createdAt  DateTime @default(now())

  chunk DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
}

model ChatSession {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("Health Query Session")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id                  String        @id @default(uuid())
  sessionId           String
  sender              MessageSender
  content             String        @db.Text
  citations           Json?         // Array of { documentId, pageNumber, excerpt }
  isHallucinationFlag Boolean       @default(false)
  createdAt           DateTime      @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model GeneratedSummary {
  id                String    @id @default(uuid())
  userId            String
  title             String
  summaryText       String    @db.Text
  timeRangeStart    DateTime?
  timeRangeEnd      DateTime?
  documentsIncluded Json      // Array of document IDs consulted
  isUserEdited      Boolean   @default(false)
  disclaimer        String    @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // e.g. "AUTH_LOGIN", "DOC_UPLOAD", "VALUE_EDIT", "DOC_EXPORT", "ACCOUNT_DELETE"
  resourceType String   // e.g. "DOCUMENT", "LAB_RESULT", "USER"
  resourceId   String?
  details      Json?    // Captured metadata (NO passwords, NO raw health values)
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([action, timestamp])
}

model ConsentRecord {
  id          String    @id @default(uuid())
  userId      String
  consentType String    // e.g. "DATA_PROCESSING", "AI_ANALYSIS", "PRIVACY_POLICY"
  granted     Boolean   @default(true)
  version     String    @default("1.0")
  ipAddress   String?
  userAgent   String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

