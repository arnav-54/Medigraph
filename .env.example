# MediGraph AI — Environment Configuration Blueprint

# Application Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL & pgvector Database URL
DATABASE_URL=postgresql://medigraph:medigraph_dev_secret@localhost:5432/medigraph_db?schema=public

# Redis Broker for BullMQ
REDIS_URL=redis://localhost:6379

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=medigraph_dev_access_secret_super_secure_key_32_chars
JWT_REFRESH_SECRET=medigraph_dev_refresh_secret_super_secure_key_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload Policies
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=15728640

# AI & Processing Service
DOCUMENT_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini # or "mock" for zero-cost offline development
OCR_PROVIDER=pymupdf # or "tesseract" / "mock"
EMBEDDING_PROVIDER=gemini # or "mock"
